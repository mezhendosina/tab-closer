{
  "manifest_version": 3,
  "name": "TabCloser",
  "version": "1.1.0",
  "description": "Automatically closes tabs you haven't switched to in 24 hours.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TabCloser",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabs", "alarms", "storage"]
}
